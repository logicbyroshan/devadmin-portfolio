# ==========================================
# DevAdmin Backend Production Configuration
# ==========================================

# Django Security
DEBUG=False
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,127.0.0.1,localhost

# Database Configuration (MySQL Production Mode)
USE_MYSQL=True
DB_NAME=devadmin_db
DB_USER=devadmin_user
DB_PASSWORD=your_strong_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Real SMTP Email Relay Configuration
USE_REAL_SMTP=True
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_specific_password
DEFAULT_FROM_EMAIL=DevAdmin Platform <noreply@yourdomain.com>

# CORS Whitelist
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com
